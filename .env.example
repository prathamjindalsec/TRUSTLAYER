# Docker Compose development/demo configuration. Copy to .env at the repository root and replace
# every placeholder before `docker compose up --build`. This file is intentionally not a production
# secret-management system.
MYSQL_DATABASE=trustlayer
MYSQL_APP_USER=trustlayer_app
MYSQL_APP_PASSWORD=replace-with-a-long-random-docker-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-long-random-root-password

# Base64 encoding of at least 32 random bytes. Example generator:
# openssl rand -base64 64
TRUSTLAYER_JWT_SECRET=replace-with-a-base64-encoded-512-bit-random-secret
TRUSTLAYER_INDICATOR_HASH_SECRET=replace-with-a-different-high-entropy-random-secret

# Demo-only: HTTP is loopback-bound by Compose. Set false only when local action-token testing is
# required; the prod profile refuses token exposure and non-Secure cookies.
TRUSTLAYER_COOKIE_SECURE=false
TRUSTLAYER_EXPOSE_ACTION_TOKENS=false
TRUSTLAYER_SCANNER_MAX_SUBMISSIONS_PER_MINUTE=30
TRUSTLAYER_TRANSACTION_MAX_ANALYSES_PER_MINUTE=20
TRUSTLAYER_THREAT_MAX_REPORTS_PER_MINUTE=10

# Leave disabled until Chrome has generated the exact extension identity; never use wildcards.
TRUSTLAYER_EXTENSION_ENABLED=false
TRUSTLAYER_EXTENSION_CLIENT_ID=
TRUSTLAYER_EXTENSION_REDIRECT_URI=
TRUSTLAYER_EXTENSION_ORIGIN=
