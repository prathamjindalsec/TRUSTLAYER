{
  "info": {
    "_postman_id": "cb8df5d4-5398-4b30-9949-64f3e9be755e",
    "name": "TRUSTLAYER - Phase 3 Authentication",
    "description": "Run requests in order. For local development only, backend/.env must set TRUSTLAYER_EXPOSE_ACTION_TOKENS=true. Postman must retain cookies for the same localhost host so refresh and CSRF requests work.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "email",
      "value": "replace-with-a-unique-email@example.test"
    },
    {
      "key": "password",
      "value": "Secure!Pass123"
    },
    {
      "key": "newPassword",
      "value": "Replaced!Pass456"
    },
    {
      "key": "firstName",
      "value": "Ada"
    },
    {
      "key": "lastName",
      "value": "Lovelace"
    },
    {
      "key": "verificationToken",
      "value": ""
    },
    {
      "key": "resetToken",
      "value": ""
    },
    {
      "key": "accessToken",
      "value": ""
    },
    {
      "key": "csrfToken",
      "value": ""
    },
    {
      "key": "sessionId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Register, verify, and sign in",
      "item": [
        {
          "name": "Register account",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('register returns 201', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "const response = pm.response.json();",
                  "if (response.data && response.data.developmentActionToken) {",
                  "    pm.collectionVariables.set('verificationToken', response.data.developmentActionToken);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\",\n  \"firstName\": \"{{firstName}}\",\n  \"lastName\": \"{{lastName}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/auth/register",
            "description": "Requires a unique email address. In local development, the response script saves developmentActionToken as verificationToken."
          },
          "response": []
        },
        {
          "name": "Verify email",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('verify returns 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"{{verificationToken}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/auth/verify-email",
            "description": "Run after Register account. If verificationToken is blank, confirm the local development action-token setting."
          },
          "response": []
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('login returns 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "const response = pm.response.json();",
                  "pm.collectionVariables.set('accessToken', response.data.accessToken);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/auth/login",
            "description": "Saves accessToken. Postman also stores trustlayer_refresh and XSRF-TOKEN cookies for localhost."
          },
          "response": []
        },
        {
          "name": "Get CSRF token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('CSRF endpoint returns 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "const response = pm.response.json();",
                  "pm.collectionVariables.set('csrfToken', response.data.token);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/auth/csrf",
            "description": "Call before protected mutations. It stores csrfToken and refreshes the XSRF-TOKEN cookie."
          },
          "response": []
        }
      ]
    },
    {
      "name": "2. Authenticated account operations",
      "item": [
        {
          "name": "Get profile",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/users/profile",
            "description": "Expected HTTP 200 after Login."
          },
          "response": []
        },
        {
          "name": "Update profile",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "X-XSRF-TOKEN",
                "value": "{{csrfToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Grace\",\n  \"lastName\": \"Hopper\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/users/profile",
            "description": "Expected HTTP 200. The XSRF-TOKEN cookie must remain in Postman's cookie jar."
          },
          "response": []
        },
        {
          "name": "List active sessions",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('sessions returns 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "const response = pm.response.json();",
                  "if (response.data.items && response.data.items.length > 0) {",
                  "    pm.collectionVariables.set('sessionId', response.data.items[0].sessionId);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/users/sessions?page=0&size=20",
            "description": "Saves the first active session ID as sessionId. Never returns refresh tokens or hashes."
          },
          "response": []
        },
        {
          "name": "Get login history",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/users/login-history?page=0&size=20",
            "description": "Expected HTTP 200. Source addresses are masked in the API."
          },
          "response": []
        },
        {
          "name": "Refresh access token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('refresh returns 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "const response = pm.response.json();",
                  "pm.collectionVariables.set('accessToken', response.data.accessToken);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-XSRF-TOKEN",
                "value": "{{csrfToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/auth/refresh",
            "description": "Expected HTTP 200. Uses the HttpOnly refresh cookie from Postman's cookie jar and rotates it."
          },
          "response": []
        },
        {
          "name": "Logout current device",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-XSRF-TOKEN",
                "value": "{{csrfToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/auth/logout",
            "description": "Expected HTTP 204. It revokes the current session, clears the refresh cookie, and invalidates the current access token."
          },
          "response": []
        },
        {
          "name": "Logout all devices",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "X-XSRF-TOKEN",
                "value": "{{csrfToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/auth/logout-all",
            "description": "Expected HTTP 204. Run only while accessToken is active; use a new Login after Logout current device."
          },
          "response": []
        },
        {
          "name": "Revoke saved session",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "X-XSRF-TOKEN",
                "value": "{{csrfToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/users/sessions/{{sessionId}}",
            "description": "Expected HTTP 204. If this is the current session, accessToken becomes invalid immediately."
          },
          "response": []
        }
      ]
    },
    {
      "name": "3. Development password recovery",
      "item": [
        {
          "name": "Request password reset",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('forgot-password returns 202', function () {",
                  "    pm.response.to.have.status(202);",
                  "});",
                  "const response = pm.response.json();",
                  "if (response.data && response.data.developmentActionToken) {",
                  "    pm.collectionVariables.set('resetToken', response.data.developmentActionToken);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/auth/forgot-password",
            "description": "Development only. Saves resetToken when the account is active and action-token exposure is enabled."
          },
          "response": []
        },
        {
          "name": "Reset password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"{{resetToken}}\",\n  \"newPassword\": \"{{newPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/auth/reset-password",
            "description": "Expected HTTP 200. All active sessions are revoked. Change the password collection variable to newPassword before logging in again."
          },
          "response": []
        }
      ]
    },
    {
      "name": "4. Destructive account operation",
      "item": [
        {
          "name": "Delete current account",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "X-XSRF-TOKEN",
                "value": "{{csrfToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/users/account",
            "description": "Expected HTTP 204. This is a soft deletion and revokes every active session. Do not run it unless that is intentional."
          },
          "response": []
        }
      ]
    }
  ]
}
