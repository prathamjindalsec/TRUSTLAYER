# Copy this file to .env only on your own machine. Never commit .env.
# For local MySQL 8 development, database traffic is restricted to 127.0.0.1.
TRUSTLAYER_DB_URL=jdbc:mysql://127.0.0.1:3306/trustlayer?useSSL=false&allowPublicKeyRetrieval=true&connectionTimeZone=UTC
TRUSTLAYER_DB_USERNAME=trustlayer_app
TRUSTLAYER_DB_PASSWORD=replace-with-a-long-random-local-password
TRUSTLAYER_FLYWAY_USERNAME=trustlayer_migrator
TRUSTLAYER_FLYWAY_PASSWORD=replace-with-a-different-long-random-local-password
TRUSTLAYER_DB_POOL_SIZE=10
TRUSTLAYER_JWT_SECRET=replace-with-a-base64-encoded-512-bit-random-secret
# Use an independent random secret in production. It HMAC-protects low-entropy community
# identifiers such as phone numbers against offline hash enumeration.
TRUSTLAYER_INDICATOR_HASH_SECRET=replace-with-a-different-high-entropy-random-secret
TRUSTLAYER_ACCESS_TOKEN_TTL=PT15M
TRUSTLAYER_REFRESH_TOKEN_TTL=P7D
# Authenticated URL scans are limited per user and per application instance in a rolling minute.
TRUSTLAYER_SCANNER_MAX_SUBMISSIONS_PER_MINUTE=30
# Community indicator reports are limited per user and per application instance in a rolling minute.
TRUSTLAYER_THREAT_MAX_REPORTS_PER_MINUTE=10
TRUSTLAYER_EXTENSION_ENABLED=false
# Copy the exact values shown on the extension options page after loading the unpacked extension.
# Never use wildcard Chrome-extension origins or Chromium callback URIs.
TRUSTLAYER_EXTENSION_CLIENT_ID=trustlayer-chrome-extension
TRUSTLAYER_EXTENSION_REDIRECT_URI=https://your-extension-id.chromiumapp.org/trustlayer
TRUSTLAYER_EXTENSION_ORIGIN=chrome-extension://your-extension-id
# false is correct for a deployment. Set true only in local development so Postman can receive
# one-time verification/reset tokens. There is intentionally no fake email sender: with false,
# those workflows return EMAIL_DELIVERY_UNAVAILABLE until a real delivery adapter is added.
TRUSTLAYER_COOKIE_SECURE=false
TRUSTLAYER_EXPOSE_ACTION_TOKENS=false
